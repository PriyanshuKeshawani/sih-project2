# SAMUDRA-AI Environment Variables Template
# Copy this file to .env and configure your keys.

# Optional: Groq Cloud API Key for System 2 Tactical Reasoning
# If left empty, SAMUDRA-AI automatically engages its verified deterministic fallback engine.
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier (defaults to llama-3.3-70b-versatile; auto-discovers accessible models)
GROQ_MODEL=llama-3.3-70b-versatile

# Server Port (default: 8000; Render sets $PORT automatically)
PORT=8000

# Edge Device Telemetry Mode: DEMO or LIVE
MISSION_MODE=DEMO
