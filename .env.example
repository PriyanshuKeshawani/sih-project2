# Ocean IQ Environment Variables Template
# Copy this file to .env and configure your variables.

# Application Operating Mode: production | recorded_real_data | test
# 'production' runs verified real sensor streams/hardware.
# 'recorded_real_data' runs historical dataset benches.
# 'test' enables isolated fixtures and unit testing.
APP_MODE=production

# Sarvam AI Tactical Reasoning API (System 2 LLM)
# If empty, Ocean IQ seamlessly uses its deterministic naval tactical synthesis engine.
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b-conversations

# Optional: Groq Cloud API Key (Alternative System 2 provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Web Server Port (Render configures $PORT automatically)
PORT=8000

# Edge Device Telemetry Mode: DEMO or LIVE
MISSION_MODE=DEMO

# Detection Confidence Threshold (default: 0.35)
CONF_THRESHOLD=0.35
